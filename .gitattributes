# Normalize line endings to LF in the repository, regardless of the
# checking-out OS. This was flagged during Phase 3 verification: a Windows
# checkout without this file was producing CRLF-vs-LF "phantom diffs" on
# files that hadn't actually changed content-wise — harmless today, but a
# real source of future merge conflicts as more contributors join.

* text=auto eol=lf

# Binary files — never touch line endings, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.safetensors binary
*.gguf binary
*.bin binary
*.ckpt binary

# Windows-specific scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
