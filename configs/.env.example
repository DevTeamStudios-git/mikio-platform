# Local development environment template.
# Copy to configs/.env (or each service's own .env) and adjust. Do not commit real secrets.

# PostgreSQL + pgvector (local development) — provisioning guide: configs/postgresql.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mikio_dev

# Electron shell — which URL the desktop app loads (apps/desktop; default http://localhost:3000)
MIKIO_WEB_APP_URL=http://localhost:3000
